---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import AllSeries from "./AllSeries.astro";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Series from "./Series.astro";
import Tag from "./Tags.astro";
import TOC from "./TOC.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	series?: string;
	showProfile?: boolean;
}

const className = Astro.props.class;
const series = Astro.props.series;
const headings = Astro.props.headings;
const showProfile =
	typeof Astro.props.showProfile === "boolean" ? Astro.props.showProfile : true;
const isPostPage = headings && headings.length > 0 && siteConfig.toc.enable;
const shouldPreserveSidebarWidgets = !isPostPage;
---
<div id="sidebar" data-page-type={isPostPage ? "post" : "default"} class:list={[className, "transition-swup-fade w-full sticky top-4", !isPostPage && "layout-default"]} style={isPostPage ? "max-height: calc(100vh - 2rem);" : ""}>
	{/* Profile container - swapped with TOC on post pages */}
	<div id="sidebar-top" class="transition-swup-fade w-full">
		{showProfile && !isPostPage &&
			<div class="flex flex-col w-full gap-4 mb-4">
				<Profile></Profile>
			</div>
		}
	</div>

	<div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4" style={isPostPage ? "max-height: calc(100vh - 2rem);" : ""}>
		{/* TOC container - uses remaining space after Series and Categories take their natural height */}
		{headings && headings.length > 0 && siteConfig.toc.enable ? (
			<div id="sidebar-toc-container" class="transition-swup-fade flex-1 min-h-0 flex flex-col">
				<div class="card-base overflow-hidden flex flex-col h-full">
					<div class="font-bold transition text-lg text-neutral-900 dark:text-neutral-100 relative ml-8 mt-4 mb-2
						before:w-1 before:h-4 before:rounded-md before:bg-[var(--primary)]
						before:absolute before:left-[-16px] before:top-[5.5px]">目录</div>
					<div id="toc-inner-wrapper" class="w-full px-2 pt-3 pb-4 overflow-y-auto hide-scrollbar flex-1 min-h-0" style="mask-image: none;">
						<div id="sidebar-toc" class="w-full relative">
							<TOC headings={headings}></TOC>
						</div>
					</div>
				</div>
			</div>
		) : (
			<div id="sidebar-toc-container" class="transition-swup-fade" style="display: none;"></div>
		)}

		<div id="series-widget" data-swup-preserve={shouldPreserveSidebarWidgets ? "sidebar-series" : undefined} class="flex flex-col w-full gap-4 flex-shrink-0">
			{ series && <Series series={ series }></Series> }
			{ !series && <AllSeries class="onload-animation" style="animation-delay: 100ms"></AllSeries> }
		</div>

		<div id="sidebar-categories" data-swup-preserve={shouldPreserveSidebarWidgets ? "sidebar-categories" : undefined} class="flex-shrink-0 w-full">
			<Categories class="onload-animation w-full" style="animation-delay: 150ms"></Categories>
		</div>

		<div id="sidebar-bottom" data-swup-preserve={shouldPreserveSidebarWidgets ? "sidebar-tags" : undefined} class="transition-swup-fade flex flex-col w-full gap-4" data-widgets={isPostPage ? "post" : "default"}>
			{!isPostPage && <Tag class="onload-animation flex-shrink-0 w-full" style="animation-delay: 200ms"></Tag>}
		</div>
		</div>
	</div>

	<script is:inline data-swup-reload-script defer>
		const schedulePaddingUpdate = () => {
			if (typeof window === "undefined") return;
			window.requestAnimationFrame(() => {
				if (typeof window.adjustPageForSidebar === "function") {
					window.adjustPageForSidebar();
				}
			});
		};

	const setupSidebarPaddingSync = () => {
		const sidebarRoot = document.getElementById("sidebar");
		const contentWrapper = document.getElementById("content-wrapper");
		const ensurePadding = () => {
			schedulePaddingUpdate();
			setTimeout(schedulePaddingUpdate, 120);
		};

		ensurePadding();
		document.addEventListener("swup:page:view", ensurePadding);

		let resizeObserver;
		if (typeof ResizeObserver !== "undefined") {
			resizeObserver = new ResizeObserver(() => schedulePaddingUpdate());
			if (sidebarRoot) resizeObserver.observe(sidebarRoot);
			if (contentWrapper) resizeObserver.observe(contentWrapper);
		}

		return () => {
			document.removeEventListener("swup:page:view", ensurePadding);
			resizeObserver?.disconnect?.();
		};
	};

	const setupSidebarToc = () => {
		const sidebar = document.getElementById("sidebar-sticky");
		const tocContainer = document.getElementById("sidebar-toc-container");
		const tocInner = document.getElementById("toc-inner-wrapper");
		const sidebarRoot = document.getElementById("sidebar");
		if (!sidebar || !tocContainer || !tocInner || tocContainer.style.display === "none") {
			schedulePaddingUpdate();
			setTimeout(schedulePaddingUpdate, 120);
			return () => {};
		}

		const isPostLayout = sidebarRoot?.dataset?.pageType === "post";

		const getVisibleChildren = () => Array.from(sidebar.children).filter((el) =>
			el instanceof HTMLElement && el.offsetParent !== null
		);

		const update = () => {
			if (!sidebar.isConnected || !tocContainer.isConnected) {
				return;
			}

			const children = getVisibleChildren();
			const tocIndex = children.indexOf(tocContainer);
			if (tocIndex === -1) {
				return;
			}

			const following = children.slice(tocIndex + 1);
			const sidebarRootRect = sidebarRoot?.getBoundingClientRect();
			const sidebarTop = sidebarRootRect ? sidebarRootRect.top : sidebar.getBoundingClientRect().top;
			const viewportAvailable = window.innerHeight - sidebarTop - 16; // leave some breathing room at bottom
			const sidebarStyles = window.getComputedStyle(sidebar);
			const gapValue = parseFloat(sidebarStyles.rowGap || sidebarStyles.gap || "0") || 0;

			const reservedHeight = following.reduce((total, el) => total + el.getBoundingClientRect().height, 0);
			const totalGap = gapValue * following.length;
			const available = Math.max(viewportAvailable - reservedHeight - totalGap, 160);

			tocContainer.style.height = `${available}px`;
			const card = tocContainer.querySelector<HTMLElement>(".card-base");
			if (card) {
				card.style.height = "100%";
			}

			if (isPostLayout && sidebarRoot) {
				// when TOC takes available space, ensure the root sidebar height reflects its content
				sidebarRoot.style.setProperty("--sidebar-content-height", `${sidebar.scrollHeight}px`);
			}
		};

		let rafHandle;
		const scheduleUpdate = () => {
			if (rafHandle) {
				cancelAnimationFrame(rafHandle);
			}
			rafHandle = window.requestAnimationFrame(() => {
				rafHandle = undefined;
				update();
				schedulePaddingUpdate();
			});
		};

		const resizeHandler = () => scheduleUpdate();
		window.addEventListener("resize", resizeHandler);

		const pageViewHandler = () => {
			scheduleUpdate();
			setTimeout(scheduleUpdate, 120);
		};
		document.addEventListener("swup:page:view", pageViewHandler);

		const roTargets = [
			document.getElementById("series-widget"),
			document.getElementById("sidebar-categories"),
			document.getElementById("sidebar-bottom"),
			sidebarRoot
		].filter((el) => el instanceof HTMLElement);

		let resizeObserver;
		if (typeof ResizeObserver !== "undefined") {
			resizeObserver = new ResizeObserver(() => scheduleUpdate());
			roTargets.forEach(target => resizeObserver?.observe(target));
		}

		scheduleUpdate();
		setTimeout(scheduleUpdate, 100);

		return () => {
			if (rafHandle) {
				cancelAnimationFrame(rafHandle);
			}
			window.removeEventListener("resize", resizeHandler);
			document.removeEventListener("swup:page:view", pageViewHandler);
			resizeObserver?.disconnect?.();
			if (tocContainer) {
				tocContainer.style.height = "";
				const card = tocContainer.querySelector(".card-base");
				if (card instanceof HTMLElement) {
					card.style.height = "";
				}
			}
		};
	};
				window.__farewe1llSidebarPaddingCleanup?.();
				window.__farewe1llSidebarPaddingCleanup = setupSidebarPaddingSync();

	window.__farewe1llSidebarTocCleanup?.();
	window.__farewe1llSidebarTocCleanup = setupSidebarToc();
	</script>
